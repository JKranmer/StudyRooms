# Copie para `.env` na raiz do projeto (fora do Git) e preencha localmente.
# Nunca coloque valores reais neste arquivo. O `start` de apps/bot e o `docker compose up bot`
# carregam esse `.env`. Salve como UTF-8 sem BOM (se houver BOM, o bot avisa ao iniciar).

# Token do bot, gerado no Discord Developer Portal, em Bot. É segredo: nunca commite nem registre em log.
DISCORD_BOT_TOKEN=

# IDs de usuário do Discord (snowflakes, de 17 a 20 dígitos) permitidos no log do spike, separados
# por vírgula, sem aspas, menções ou nomes; exemplo: 123456789012345678,234567890123456789.
# Obrigatório: quem não está na lista não aparece no log. Existe só no spike, por privacidade.
# Item que não é numérico impede a subida; tamanho fora de 17 a 20 dígitos gera aviso.
BOT_TEST_ALLOWLIST_USER_IDS=

# Postgres local do compose (`docker compose up db`). Escolha uma senha local qualquer; sem ela,
# o container não sobe. Usuário, banco e porta têm padrão (studyrooms, studyrooms, 5432).
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=

# Conexão usada pelo migrate de packages/db (`pnpm --filter @studyrooms/db migrate`). Para o banco
# local: postgres://USUARIO:SENHA@127.0.0.1:PORTA/BANCO, com os valores acima. É segredo quando
# apontar para o Neon: nunca commite nem registre em log.
DATABASE_URL=
