# Copie para `.env` na raiz do projeto (fora do Git) e preencha localmente.
# Nunca coloque valores reais neste arquivo. O `start` de apps/bot e o `docker compose up bot`
# carregam esse `.env`. Salve como UTF-8 sem BOM (se houver BOM, o bot avisa ao iniciar).

# Token do bot, gerado no Discord Developer Portal, em Bot. É segredo: nunca commite nem registre em log.
DISCORD_BOT_TOKEN=

# Lista de consentimento explícito da coleta antecipada (D-29): IDs de usuário do Discord
# (snowflakes, de 17 a 20 dígitos), separados por vírgula, sem aspas, menções ou nomes; exemplo:
# 123456789012345678,234567890123456789. Obrigatória: quem não está na lista não é gravado no banco
# nem aparece no log. Só entra quem deu consentimento explícito. Revogar é tirar o ID e reiniciar
# o bot. Item que não é numérico impede a subida; tamanho fora de 17 a 20 dígitos gera aviso.
# Será substituída pelo consentimento real (F1-26).
BOT_TEST_ALLOWLIST_USER_IDS=

# Conexão que o bot usa para gravar os eventos brutos de voz (F1-47). Obrigatória: sem ela, o bot
# não sobe. Formato postgres://USUARIO:SENHA@HOST:PORTA/BANCO. Para o banco local rodando o bot
# fora do Docker, o host é 127.0.0.1; com o bot no compose, o host é `db`. Na VM, é o valor de
# NEON_BOT_URL (papel que só insere, F1-48). É segredo: nunca commite nem registre em log.
BOT_DATABASE_URL=

# Pasta da fila em disco, onde ficam os eventos que ainda não chegaram ao banco. Opcional: fora
# do Docker, o padrão é `.data/bot-queue` na raiz (fora do Git); no Docker, o volume `bot-queue`.
# Contém IDs do Discord, inclusive em `quarantine.jsonl` (eventos recusados pelo banco).
BOT_QUEUE_DIR=

# Postgres local do compose (`docker compose up db`). Escolha uma senha local qualquer; sem ela,
# o container não sobe. Usuário, banco e porta têm padrão (studyrooms, studyrooms, 5432).
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=

# Conexão usada pelo migrate de packages/db (`pnpm --filter @studyrooms/db migrate`). Para o banco
# local: postgres://USUARIO:SENHA@127.0.0.1:PORTA/BANCO, com os valores acima. Só para o banco
# local: para o Neon, use NEON_ADMIN_URL e `neon migrate` (abaixo).
DATABASE_URL=

# Neon (F1-48). Passo a passo em docs/runbooks/neon.md. Usadas só pelos comandos
# `pnpm --filter @studyrooms/db neon ...`, que nunca imprimem as URLs. Não substituem as variáveis
# do banco local acima. Todas terminam com `?sslmode=verify-full` (ou `require`). São segredo.
#
# Papel dono do banco (neondb_owner), conexão direta (sem `-pooler` no host). Só no PC do usuário,
# para migrations, criação dos papéis e exclusão a pedido. Nunca vai para a VM.
NEON_ADMIN_URL=
# Papel do bot (studyrooms_bot): só insere em raw_voice_events. Gerada por `neon roles`. Na VM, o
# mesmo valor vai em BOT_DATABASE_URL.
NEON_BOT_URL=
# Papel do backup (studyrooms_backup): só lê. Gerada por `neon roles`; usada pelo backup local (F1-24).
NEON_BACKUP_URL=
