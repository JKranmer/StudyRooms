# Copie para `.env` (fora do Git) e preencha localmente. Nunca coloque valores reais neste arquivo.
# O código ainda não lê nenhuma destas variáveis: elas passam a ser usadas na F0-02.

# Token do bot, gerado no Discord Developer Portal, em Bot. É segredo: nunca commite nem registre em log.
DISCORD_BOT_TOKEN=

# IDs de usuário do Discord (snowflakes) permitidos no log do spike, separados por vírgula.
# Quem não está na lista não aparece no log. Existe só no spike, por privacidade.
BOT_TEST_ALLOWLIST_USER_IDS=
